DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mylo_edge
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# local is explicitly DEMO; use crypto for CoinGecko-backed crypto candles
MARKET_DATA_PROVIDER=local
MARKET_DATA_API_KEY=
NEWS_PROVIDER=local
NEWS_API_KEY=
FUNDAMENTALS_PROVIDER=local
FUNDAMENTALS_API_KEY=
MACRO_PROVIDER=local
MACRO_API_KEY=
TRADINGAGENTS_PROVIDER=local
# Enable the pinned official adapter with: TRADINGAGENTS_PROVIDER=tradingagents
TRADINGAGENTS_VERSION=v0.2.0
# Optional path to a checked-out official TradingAgents repository
TRADINGAGENTS_SOURCE_PATH=
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_MODEL=gpt-5.2
TRADINGAGENTS_QUICK_MODEL=gpt-5-mini
TRADINGAGENTS_BACKEND_URL=https://api.openai.com/v1
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_API_KEY=
# TradingAgents reads the selected provider's key directly:
# OPENAI_API_KEY=, GOOGLE_API_KEY=, ANTHROPIC_API_KEY=, XAI_API_KEY=,
# OPENROUTER_API_KEY=, or use Ollama locally without a hosted key.
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173
