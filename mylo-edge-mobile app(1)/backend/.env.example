DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mylo_edge
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# local is explicitly DEMO; use crypto for CoinGecko-backed crypto candles
MARKET_DATA_PROVIDER=local
MARKET_DATA_API_KEY=
NEWS_PROVIDER=local
NEWS_API_KEY=
FUNDAMENTALS_PROVIDER=local
FUNDAMENTALS_API_KEY=
MACRO_PROVIDER=local
MACRO_API_KEY=
TRADINGAGENTS_PROVIDER=openrouter
TRADINGAGENTS_VERSION=v0.2.0
# Optional path to a checked-out official TradingAgents repository
TRADINGAGENTS_SOURCE_PATH=
TRADINGAGENTS_LLM_PROVIDER=openrouter
TRADINGAGENTS_DEEP_THINKING_MODEL=google/gemma-2-9b-it:free
TRADINGAGENTS_QUICK_THINKING_MODEL=meta-llama/llama-3-8b-instruct:free
TRADINGAGENTS_BACKEND_URL=https://openrouter.ai/api/v1
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_API_KEY=
OPENROUTER_API_KEY=your_free_openrouter_key_here
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173
